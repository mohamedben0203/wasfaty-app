# Same Supabase project as wasfati-portal (the anon key is the public one)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Turns on the temporary test number (094 005 5000, code 123456) in a build.
# It is always on in `npm run dev`. Leave it out of real deployments.
# VITE_ENABLE_TEST_NUMBER=true

# Where the health service serves PDF reports (optional, this is the default)
VITE_REPORT_BASE_URL=https://health.zbuny.com
